# Stellar Split runs on Stellar Testnet only.
# Shared Testnet values. Each app reads its own file: the API reads apps/api/.env (Supabase,
# sessions, agents; see apps/api/.env.example) and the web app reads apps/web/.env.
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Populate this after the public demo integration values are confirmed.
# Do not treat repository deployment evidence as the USDC demo configuration.
GROUP_CONTRACT_ID=

# Circle Testnet USDC, confirmed on Testnet (see the README, "Deployed on Stellar Testnet").
USDC_ASSET_CODE=USDC
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
USDC_TOKEN_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Optional (#98): Circle's EURC on Testnet, so a group can settle in euros. Leave empty for USDC groups only.
# This is the Testnet issuer from Circle's EURC address list; the mainnet issuer is a different address.
# Run database/migrations/003_group_asset.sql before creating a EURC group.
EURC_ISSUER=

# Optional x402 stretch integration. Keep credentials server-side.
X402_FACILITATOR_URL=
X402_FACILITATOR_API_KEY=
