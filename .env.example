SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Deployed non-custodial group contract.
GROUP_CONTRACT_ID=CAZDOCJJR3NU5O2N44KQSWUG7C4OBLC6PIQLBFVPXODAYHHITFU7FR3Y

# Required before the USDC demo. Set this to the verified Testnet USDC
