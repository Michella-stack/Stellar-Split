# Copy to .env and fill in. Never commit .env.
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
# Testnet USDC issuer (Circle), confirmed on Testnet (issue #43, README "Deployed on Stellar Testnet").
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Supabase: project URL and service role key (server side only). Leave both empty to use the in-memory store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ALLOW_MEMORY_STORE=true
# Web app origin, used for CORS and invite links
APP_URL=http://localhost:5173
# Receipt scan (demo, issue #87). Optional: without a key the scan route answers 503 and the web app shows its sample result.
# Server side only, never a VITE_ variable. Create it in Google AI Studio. On the free tier Google may use what is sent to
# improve its products, so use sample receipts only.
GEMINI_API_KEY=
RECEIPT_MODEL=gemini-3.8-flash
# Agents: comma-separated sha256(token)=GADDRESS pairs. Only the hash goes here.
AGENT_TOKENS=
# Signs sessions and challenges. 32+ random characters, e.g. openssl rand -base64 48
SESSION_SECRET=
HOST=127.0.0.1
PORT=8080
