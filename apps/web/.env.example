# All VITE_ variables end up in the browser bundle. Never put a secret here.

# true: the API client returns local mock data. false: it calls VITE_API_URL.
VITE_USE_MOCKS=true
# Base URL of the Stellar-Split API (no trailing slash).
VITE_API_URL=http://localhost:8080
# Stellar Testnet Horizon.
VITE_HORIZON_URL=https://horizon-testnet.stellar.org
# Issuer of Circle Testnet USDC (developers.stellar.org x402 quickstart; home domain centre.io on Horizon).
VITE_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# The app refuses to run on anything else.
VITE_NETWORK=testnet

# Mock mode only: a real Testnet account (with a USDC trustline) that plays "Mateo" in the demo data,
# so "Settle up" sends a real Testnet payment to it. Public address only, never a secret key.
VITE_MOCK_MATEO_ADDRESS=
